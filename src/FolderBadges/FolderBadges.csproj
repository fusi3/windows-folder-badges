<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The icon shown on the .exe in Explorer and in the tray -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Shown in the .exe's Properties → Details. Bump Version for each GitHub release. -->
    <Version>0.1.0</Version>
    <!-- Show just "0.1.0", without the Git commit code .NET adds by default -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>FolderBadges</Product>
    <Description>Shows a red count badge on folder icons</Description>
    <Copyright>Copyright (c) 2026 Fasih Munir</Copyright>
  </PropertyGroup>

  <!-- Release build settings, used by "dotnet publish -c Release" (build-release.ps1 runs it for you).
       Produces one FolderBadges.exe with no loose .dll files next to it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- true = .NET is packed inside the .exe, so it runs on any Windows PC (big file).
         Pass -p:SelfContained=false for a small .exe that needs the .NET 10 Desktop Runtime installed. -->
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <!-- Packs everything into the one .exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No .pdb debugging file in the release folder -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Makes the big .exe much smaller; it unpacks in memory when started (only works with .NET packed inside) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
